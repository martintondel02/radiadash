{
  "name": "radiadash",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.0",
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "scripts": {
    "dev": "pnpm --filter @radiadash/desktop dev",
    "build": "pnpm --filter @radiadash/desktop build",
    "tauri": "pnpm --filter @radiadash/desktop tauri",
    "probe": "cargo run -p radiadash-probe --"
  }
}
