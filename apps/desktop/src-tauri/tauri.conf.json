{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radiadash",
  "version": "0.1.0",
  "identifier": "io.github.martintondel.radiadash",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Radiadash",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "appimage"],
    "category": "Science",
    "shortDescription": "RadiaCode 110 dashboard and spectrometer",
    "longDescription": "Live counts, dose, spectra, isotope candidates and maps for RadiaCode radiation detectors.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
